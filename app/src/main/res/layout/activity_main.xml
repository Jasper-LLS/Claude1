<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/orange_primary"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/scoring_explanation"
        android:textSize="14sp"
        android:textColor="@color/black"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/buttonPlayers"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:text="@string/menu_predictions" />

    <Button
        android:id="@+id/buttonRound"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:text="@string/menu_round" />

    <Button
        android:id="@+id/buttonStandings"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:text="@string/menu_standings" />

    <Button
        android:id="@+id/buttonTeams"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/menu_teams" />

</LinearLayout>
